POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=global_learn
PGDATA=/var/lib/postgresql/18/docker

REDIS_IP=localhost
REDIS_PORT=6379

PORT=5000

DATABASE_URL=postgresql://postgres:postgres@localhost:5434/global_learn

JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

SMTP_HOST=localhost
SMTP_PORT=1025
